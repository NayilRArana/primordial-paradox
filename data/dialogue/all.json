{
  "format": 1,
  "kind": "dialogues",
  "dialogue": [
    {
      "id": "ship_rail_note",
      "speaker": "narrator",
      "lines": [
        "* The deck tilts. The mop does not.",
        "* A sailor blocks the hatch.",
        "* He checks his parking ticket."
      ]
    },
    {
      "id": "ship_gangway",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* The horn shakes the deck.",
            "* Salt, rope and wet paint.",
            "* The mop has seen worse."
          ]
        }
      ]
    },
    {
      "id": "ship_log_open",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* A log book, chained down.",
            "* The last entry: no cargo.",
            "* One pen. Also chained."
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* You sign below that.",
            "* The pen works. Suspicious.",
            "* Then the book is shut."
          ]
        }
      ]
    },
    {
      "id": "ship_aboard",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* A plank, then a rail.",
            "* The pier is behind you.",
            "* Your welcome: a wet sock."
          ]
        }
      ]
    },
    {
      "id": "battle_intro_sailors",
      "speaker": "narrator",
      "lines": [
        "* A Navy Sailor squares up.",
        "* His mop is regulation.",
        "* TALK or FIGHT. Choose."
      ]
    },
    {
      "id": "talk_navy_sailor",
      "speaker": "sailor",
      "lines": [
        "* \"You are not on the list.\"",
        "* \"The bridge sees all.\"",
        "* \"Go on. I hate the watch.\""
      ]
    },
    {
      "id": "navy_win_kill",
      "speaker": "narrator",
      "lines": [
        "* The sailor does not get up.",
        "* The deck is very quiet."
      ]
    },
    {
      "id": "navy_win_spare",
      "speaker": "narrator",
      "lines": [
        "* He steps aside.",
        "* His eyes stay on the sea.",
        "* \"Bridge is that way. Move.\""
      ]
    },
    {
      "id": "navy_spare_refused",
      "speaker": "narrator",
      "lines": [
        "* You lower your hands.",
        "* The sailor keeps his mop up.",
        "* \"Not before my relief.\""
      ]
    },
    {
      "id": "navy_epilogue_spare",
      "speaker": "narrator",
      "lines": [
        "* He keeps the watch alone.",
        "* The hatch stays open behind him.",
        "* He writes one name in the book."
      ]
    },
    {
      "id": "navy_epilogue_kill",
      "speaker": "narrator",
      "lines": [
        "* The watch is over.",
        "* The hatch is open to anyone.",
        "* The sea does not turn round."
      ]
    },
    {
      "id": "percy_lore_stop",
      "speaker": "narrator",
      "lines": [
        "* Percy fills the doorway.",
        "* \"NAME. BUSINESS. VEIL.\"",
        "* \"IN THAT ORDER.\""
      ]
    },
    {
      "id": "percy_entry",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* \"A stowaway with a god.\"",
        "* \"STATE YOUR BUSINESS.\"",
        "* Percy lifts the trident."
      ]
    },
    {
      "id": "talk_percy",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* \"STILL TALKING. NOTED.\"",
        "* \"THE VEIL. YOUR QUESTION.\"",
        "* \"PLAINLY.\""
      ]
    },
    {
      "id": "talk_percy_phase2",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* \"THE TIDE TURNS. LOG IT.\"",
        "* \"THE VEIL. AGAIN.\"",
        "* \"THAT IS THE VEIL.\""
      ]
    },
    {
      "id": "percy_phase2_line",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* Percy plants the trident.",
        "* \"INJURY. NOT SURRENDER.\"",
        "* The water answers him."
      ]
    },
    {
      "id": "talk_percy_phase3",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* \"RAIN. WALL. FAN.\"",
        "* \"FINAL DRILL.\"",
        "* \"NAME ME, OR DROWN.\""
      ]
    },
    {
      "id": "percy_phase3_line",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* Percy opens the sea wide.",
        "* \"FULL FLOOD. AUTHORISED.\"",
        "* The whole sea comes with it."
      ]
    },
    {
      "id": "percy_interrupt_line",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* \"Wait. Who says my name?\"",
        "* The trident dips an inch."
      ]
    },
    {
      "id": "prometheus_veil_line",
      "speaker": "prometheus",
      "portrait": "prometheus",
      "lines": [
        "* \"Peace, tide-bitten.\"",
        "* \"I am the fire's name.\"",
        "* \"Mortals walk behind a veil\"",
        "* \"It hides gods, not knives.\"",
        "* \"End this here.\"",
        "* \"The dead rise in London.\"",
        "* \"They rise for its sleep.\""
      ]
    },
    {
      "id": "percy_epilogue_spare",
      "speaker": "narrator",
      "lines": [
        "* Percy sits against the mast.",
        "* \"The fire-carrier took you.\"",
        "* \"The hatch is yours.\""
      ]
    },
    {
      "id": "percy_epilogue_kill",
      "speaker": "narrator",
      "lines": [
        "* The trident lies in two.",
        "* Percy does not move.",
        "* \"The veil thins tonight.\""
      ]
    },
    {
      "id": "percy_win_kill",
      "speaker": "narrator",
      "lines": [
        "* The trident falls first.",
        "* Then the man.",
        "* The sea goes flat."
      ]
    },
    {
      "id": "percy_win_spare",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* \"Keep your fire, then.\"",
        "* \"Do not ask me for water.\""
      ]
    },
    {
      "id": "battle_lose",
      "speaker": "narrator",
      "lines": [
        "* The deck rises to meet you.",
        "* Your last save still stands."
      ]
    },
    {
      "id": "battle_intro_hound",
      "speaker": "narrator",
      "lines": [
        "* Something moves by the rope.",
        "* A thin hound guards one knot.",
        "* FIGHT ends this in one blow."
      ]
    },
    {
      "id": "talk_deck_hound",
      "speaker": "hound",
      "lines": [
        "* A low growl. Then a thump.",
        "* It sniffs the salt on your hands.",
        "* It waits. You have the knife."
      ]
    },
    {
      "id": "hound_win_kill",
      "speaker": "narrator",
      "lines": [
        "* One blow. The hound is still.",
        "* You step over the rope."
      ]
    },
    {
      "id": "hound_win_spare",
      "speaker": "narrator",
      "lines": [
        "* The hound rolls over.",
        "* It lets you pass the rope.",
        "* It keeps the knot."
      ]
    },
    {
      "id": "quay_gate_checkpoint",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* Rain on the barrier arm.",
            "* A hut. One lit window.",
            "* The guard hides a form."
          ]
        },
        {
          "speaker": "guard",
          "portrait": "guard",
          "lines": [
            "* \"That is far enough.\"",
            "* \"Name and business.\"",
            "* He caps his pen twice."
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* Past him the yard is dark.",
            "* Past that, a grey hull.",
            "* The Itchen takes the rain."
          ]
        }
      ]
    },
    {
      "id": "quay_gate_choice",
      "speaker": "guard",
      "portrait": "guard",
      "pages": [
        {
          "speaker": "guard",
          "portrait": "guard",
          "lines": [
            "* \"No pass, no gate.\"",
            "* \"So. What is it?\"",
            "* The pen waits. It is dry."
          ]
        }
      ],
      "choices": [
        {
          "label": "No pass.",
          "sets": [
            "gate_passed",
            "gate_truth"
          ],
          "goto": "quay_gate_truth"
        },
        {
          "label": "Crew list.",
          "sets": [
            "gate_passed",
            "gate_bluff"
          ],
          "goto": "quay_gate_bluff"
        },
        {
          "label": "Officer.",
          "sets": [
            "gate_passed",
            "gate_authority"
          ],
          "goto": "quay_gate_authority"
        }
      ]
    },
    {
      "id": "quay_gate_truth",
      "speaker": "guard",
      "portrait": "guard",
      "pages": [
        {
          "speaker": "guard",
          "portrait": "guard",
          "lines": [
            "* \"Honest. That is new.\"",
            "* \"Office. Sign in.\""
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* He lifts the arm himself."
          ]
        }
      ]
    },
    {
      "id": "quay_gate_bluff",
      "speaker": "guard",
      "portrait": "guard",
      "pages": [
        {
          "speaker": "guard",
          "portrait": "guard",
          "lines": [
            "* \"The list is full.\"",
            "* \"Office, then. Sign.\""
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* The page says TEA."
          ]
        }
      ]
    },
    {
      "id": "quay_gate_authority",
      "speaker": "guard",
      "portrait": "guard",
      "pages": [
        {
          "speaker": "guard",
          "portrait": "guard",
          "lines": [
            "* \"My officer is asleep.\"",
            "* \"Office. Now.\""
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* The kettle snores too."
          ]
        }
      ]
    },
    {
      "id": "quay_dock_office",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* Counter. A lamp. A ledger.",
            "* Two men. One is Navy.",
            "* The other owns the kettle."
          ]
        },
        {
          "speaker": "clerk",
          "lines": [
            "* \"You are the last one.\"",
            "* \"Name, then. Slowly.\"",
            "* The pen is already wet."
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* A line left in the ledger.",
            "* The ink on it is dry.",
            "* Beside it: a tea ring."
          ]
        }
      ]
    },
    {
      "id": "quay_dock_office_pass",
      "speaker": "clerk",
      "pages": [
        {
          "speaker": "clerk",
          "lines": [
            "* \"Berth nine. Deck two.\"",
            "* \"Do not leave the cabin.\"",
            "* He tears a pink slip."
          ]
        },
        {
          "speaker": "sailor",
          "lines": [
            "* \"Sign it and come on.\"",
            "* \"I have a ladder to hold.\"",
            "* \"It is holding my tea.\""
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* The slip changes hands.",
            "* It is warm from a pocket.",
            "* The gate shuts behind you."
          ]
        }
      ],
      "sets": [
        "has_boarding_pass"
      ]
    },
    {
      "id": "say_door_register",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Registry shut. No queue.",
            "* Your number is up. Later."
          ]
        }
      ]
    },
    {
      "id": "say_door_dancing_man",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* A pub. Warm. Loud. Dry.",
            "* Rain files a complaint."
          ]
        }
      ]
    },
    {
      "id": "say_door_oceana",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Flats. The bells quit.",
            "* Everyone waits for a text."
          ]
        }
      ]
    },
    {
      "id": "say_door_telephone",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Telephone House. No call.",
            "* The receiver is off duty."
          ]
        }
      ]
    },
    {
      "id": "say_door_kuti",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* A kitchen, still open.",
            "* Vinegar. Hot oil. Salt."
          ]
        }
      ]
    },
    {
      "id": "say_door_red_funnel",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Ferries. Not your ship.",
            "* Yours has worse snacks."
          ]
        }
      ]
    },
    {
      "id": "say_door_playhouse",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Dark door. Tonight: SHUT.",
            "* The poster looks relieved."
          ]
        }
      ]
    },
    {
      "id": "drive_sign_55",
      "speaker": "narrator",
      "lines": [
        "* SOUTHAMPTON 55.",
        "* BASINGSTOKE 20.",
        "* The countdown starts."
      ]
    },
    {
      "id": "drive_sign_43",
      "speaker": "narrator",
      "lines": [
        "* SOUTHAMPTON 43.",
        "* BASINGSTOKE 8.",
        "* Twelve miles gone. No crisps."
      ]
    },
    {
      "id": "drive_sign_30",
      "speaker": "narrator",
      "lines": [
        "* SOUTHAMPTON 30.",
        "* WINCHESTER 12.",
        "* The sea is on the radio."
      ]
    },
    {
      "id": "drive_sign_20",
      "speaker": "narrator",
      "lines": [
        "* SOUTHAMPTON 20.",
        "* WINCHESTER 2.",
        "* One lane now. Snack wrapper."
      ]
    },
    {
      "id": "drive_radio_1",
      "speaker": "narrator",
      "lines": [
        "* The radio finds a station.",
        "* Rain from the west.",
        "* It sends its regards."
      ]
    },
    {
      "id": "drive_radio_2",
      "speaker": "narrator",
      "lines": [
        "* Winchester loses a lane.",
        "* The car does not slow.",
        "* Dad calls it momentum."
      ]
    },
    {
      "id": "drive_radio_3",
      "speaker": "narrator",
      "lines": [
        "* A phone in, on the storm.",
        "* He says it is not natural.",
        "* His bins are still outside."
      ]
    },
    {
      "id": "drive_radio_4",
      "speaker": "narrator",
      "lines": [
        "* The news. A power cut.",
        "* Two streets, dark.",
        "* The fridge goes on strike."
      ]
    },
    {
      "id": "drive_radio_5",
      "speaker": "narrator",
      "lines": [
        "* Wight. Portland. Force 8.",
        "* The reader says it twice.",
        "* The sea was not listening."
      ]
    },
    {
      "id": "drive_radio_6",
      "speaker": "narrator",
      "lines": [
        "* Portsmouth. Sailings held.",
        "* Nothing sails before dawn.",
        "* The car is not a boat."
      ]
    },
    {
      "id": "drive_radio_7",
      "speaker": "narrator",
      "lines": [
        "* Static. Then a voice.",
        "* It says the road is clear.",
        "* The car keeps its speed."
      ]
    },
    {
      "id": "drive_cathedral",
      "speaker": "narrator",
      "lines": [
        "* A long nave on the hill.",
        "* A square tower. No lights.",
        "* Winchester is asleep."
      ]
    }
  ]
}
