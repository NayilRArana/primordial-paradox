{
  "format": 1,
  "kind": "dialogues",
  "dialogue": [
    {
      "id": "ship_rail_note",
      "speaker": "narrator",
      "lines": [
        "* The deck tilts. The mop does not.",
        "* A sailor blocks the hatch.",
        "* He checks his parking ticket."
      ]
    },
    {
      "id": "ship_gangway",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* The horn shakes the deck.",
            "* Salt, rope and wet paint.",
            "* The mop has seen worse."
          ]
        }
      ]
    },
    {
      "id": "ship_log_open",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* A log book, chained down.",
            "* The last entry: no cargo.",
            "* One pen. Also chained."
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* You sign below that.",
            "* The pen works. Suspicious.",
            "* Then the book is shut."
          ]
        }
      ]
    },
    {
      "id": "ship_aboard",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* A plank, then a rail.",
            "* The pier is behind you.",
            "* Your welcome: a wet sock."
          ]
        }
      ]
    },
    {
      "id": "battle_intro_sailors",
      "speaker": "narrator",
      "lines": [
        "* A sailor holds the hatch.",
        "* \"Deck is closed. Orders.\"",
        "* Talk him down, or fight."
      ]
    },
    {
      "id": "talk_navy_sailor",
      "speaker": "sailor",
      "lines": [
        "* \"You are not on the list.\"",
        "* \"The bridge sees all.\"",
        "* \"Go on. I hate the watch.\""
      ]
    },
    {
      "id": "navy_win_kill",
      "speaker": "narrator",
      "lines": [
        "* The sailor drops his mop.",
        "* The hatch is unguarded.",
        "* The deck is very quiet."
      ]
    },
    {
      "id": "navy_win_spare",
      "speaker": "narrator",
      "lines": [
        "* He lowers the mop.",
        "* \"Hatch is open. Move.\"",
        "* His eyes stay on the sea."
      ]
    },
    {
      "id": "navy_spare_refused",
      "speaker": "narrator",
      "lines": [
        "* You lower your hands.",
        "* The sailor keeps his mop up.",
        "* \"Not before my relief.\""
      ]
    },
    {
      "id": "navy_epilogue_spare",
      "speaker": "narrator",
      "lines": [
        "* He keeps the watch alone.",
        "* The hatch stays open behind him.",
        "* He writes one name in the book."
      ]
    },
    {
      "id": "navy_epilogue_kill",
      "speaker": "narrator",
      "lines": [
        "* The watch is over.",
        "* The hatch is open to anyone.",
        "* The sea does not turn round."
      ]
    },
    {
      "id": "percy_lore_stop",
      "speaker": "narrator",
      "lines": [
        "* An officer's cabin.",
        "* Brass lamp. Charts. A log.",
        "* Lt. Percy Skye, aged 23.",
        "* \"NAME. BUSINESS. VEIL.\"",
        "* \"IN THAT ORDER.\""
      ]
    },
    {
      "id": "percy_entry",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* \"Aboard. In my office.\"",
        "* \"STATE YOUR BUSINESS.\"",
        "* Percy lifts the trident."
      ]
    },
    {
      "id": "talk_percy",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* \"STILL TALKING. NOTED.\"",
        "* \"THE VEIL. YOUR QUESTION.\"",
        "* \"PLAINLY.\""
      ]
    },
    {
      "id": "talk_percy_phase2",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* \"THE TIDE TURNS. LOG IT.\"",
        "* \"THE VEIL. AGAIN.\"",
        "* \"THAT IS THE VEIL.\""
      ]
    },
    {
      "id": "percy_phase2_line",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* Percy plants the trident.",
        "* \"INJURY. NOT SURRENDER.\"",
        "* The water answers him."
      ]
    },
    {
      "id": "talk_percy_phase3",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* \"RAIN. WALL. FAN.\"",
        "* \"FINAL DRILL.\"",
        "* \"NAME ME, OR DROWN.\""
      ]
    },
    {
      "id": "percy_phase3_line",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* Percy opens the sea wide.",
        "* \"FULL FLOOD. AUTHORISED.\"",
        "* The whole sea comes with it."
      ]
    },
    {
      "id": "percy_interrupt_line",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* \"Wait. Who says my name?\"",
        "* The trident dips an inch."
      ]
    },
    {
      "id": "prometheus_veil_line",
      "speaker": "prometheus",
      "portrait": "prometheus",
      "lines": [
        "* \"Peace, tide-bitten.\"",
        "* \"I am the fire's name.\"",
        "* \"Mortals walk behind a veil\"",
        "* \"It hides gods, not knives.\"",
        "* \"End this here.\"",
        "* \"The dead rise in London.\"",
        "* \"They rise for its sleep.\""
      ]
    },
    {
      "id": "percy_epilogue_spare",
      "speaker": "narrator",
      "lines": [
        "* Percy sits at his desk.",
        "* \"The fire-carrier took you.\"",
        "* \"The hatch is yours.\""
      ]
    },
    {
      "id": "percy_epilogue_kill",
      "speaker": "narrator",
      "lines": [
        "* The trident lies in two.",
        "* Percy does not move.",
        "* \"The veil thins tonight.\""
      ]
    },
    {
      "id": "percy_win_kill",
      "speaker": "narrator",
      "lines": [
        "* The trident falls first.",
        "* Then the man.",
        "* The sea goes flat."
      ]
    },
    {
      "id": "percy_win_spare",
      "speaker": "percy",
      "portrait": "percy",
      "lines": [
        "* \"Keep your fire, then.\"",
        "* \"Do not ask me for water.\""
      ]
    },
    {
      "id": "battle_lose",
      "speaker": "narrator",
      "lines": [
        "* The wind knocks you flat.",
        "* Your last save still stands."
      ]
    },
    {
      "id": "battle_intro_hound",
      "speaker": "narrator",
      "lines": [
        "* Something moves by the rope.",
        "* A thin hound guards one knot.",
        "* FIGHT ends this in one blow."
      ]
    },
    {
      "id": "talk_deck_hound",
      "speaker": "hound",
      "lines": [
        "* A low growl. Then a thump.",
        "* It sniffs the salt on your hands.",
        "* It waits. You have the knife."
      ]
    },
    {
      "id": "hound_win_kill",
      "speaker": "narrator",
      "lines": [
        "* One blow. The hound is still.",
        "* You step over the rope."
      ]
    },
    {
      "id": "hound_win_spare",
      "speaker": "narrator",
      "lines": [
        "* The hound rolls over.",
        "* It lets you pass the rope.",
        "* It keeps the knot."
      ]
    },
    {
      "id": "say_door_register",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Registry shut. No queue.",
            "* Your number is up. Later."
          ]
        }
      ]
    },
    {
      "id": "say_door_dancing_man",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* A pub. Warm. Loud. Dry.",
            "* Rain files a complaint."
          ]
        }
      ]
    },
    {
      "id": "say_door_oceana",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Flats. The bells quit.",
            "* Everyone waits for a text."
          ]
        }
      ]
    },
    {
      "id": "say_door_telephone",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Telephone House. No call.",
            "* The receiver is off duty."
          ]
        }
      ]
    },
    {
      "id": "say_door_kuti",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* A kitchen, still open.",
            "* Vinegar. Hot oil. Salt."
          ]
        }
      ]
    },
    {
      "id": "say_door_red_funnel",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Ferries. Not your ship.",
            "* Yours has worse snacks."
          ]
        }
      ]
    },
    {
      "id": "say_door_playhouse",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Dark door. Tonight: SHUT.",
            "* The poster looks relieved."
          ]
        }
      ]
    },
    {
      "id": "drive_sign_55",
      "speaker": "narrator",
      "lines": [
        "* SOUTHAMPTON 55.",
        "* BASINGSTOKE 20.",
        "* The countdown starts."
      ]
    },
    {
      "id": "drive_sign_43",
      "speaker": "narrator",
      "lines": [
        "* SOUTHAMPTON 43.",
        "* BASINGSTOKE 8.",
        "* Twelve miles gone. No crisps."
      ]
    },
    {
      "id": "drive_sign_30",
      "speaker": "narrator",
      "lines": [
        "* SOUTHAMPTON 30.",
        "* WINCHESTER 12.",
        "* The sea is on the radio."
      ]
    },
    {
      "id": "drive_sign_20",
      "speaker": "narrator",
      "lines": [
        "* SOUTHAMPTON 20.",
        "* WINCHESTER 2.",
        "* One lane now. Snack wrapper."
      ]
    },
    {
      "id": "drive_radio_1",
      "speaker": "narrator",
      "lines": [
        "* The radio finds a station.",
        "* Rain from the west.",
        "* It sends its regards."
      ]
    },
    {
      "id": "drive_radio_2",
      "speaker": "narrator",
      "lines": [
        "* Winchester loses a lane.",
        "* The car does not slow.",
        "* Dad calls it momentum."
      ]
    },
    {
      "id": "drive_radio_3",
      "speaker": "narrator",
      "lines": [
        "* A phone in, on the storm.",
        "* He says it is not natural.",
        "* His bins are still outside."
      ]
    },
    {
      "id": "drive_radio_4",
      "speaker": "narrator",
      "lines": [
        "* The news. A power cut.",
        "* Two streets, dark.",
        "* The fridge goes on strike."
      ]
    },
    {
      "id": "drive_radio_5",
      "speaker": "narrator",
      "lines": [
        "* Wight. Portland. Force 8.",
        "* The reader says it twice.",
        "* The sea was not listening."
      ]
    },
    {
      "id": "drive_radio_6",
      "speaker": "narrator",
      "lines": [
        "* Portsmouth. Sailings held.",
        "* Nothing sails before dawn.",
        "* The car is not a boat."
      ]
    },
    {
      "id": "drive_radio_7",
      "speaker": "narrator",
      "lines": [
        "* Static. Then a voice.",
        "* It says the road is clear.",
        "* The car keeps its speed."
      ]
    },
    {
      "id": "drive_cathedral",
      "speaker": "narrator",
      "lines": [
        "* A long nave on the hill.",
        "* A square tower. No lights.",
        "* Winchester is asleep."
      ]
    },
    {
      "id": "battle_intro_morgan",
      "speaker": "narrator",
      "lines": [
        "* Morgan drops the barrier.",
        "* \"Bag check. Regulations.\"",
        "* Talk him round, or fight."
      ]
    },
    {
      "id": "talk_morgan",
      "speaker": "guard",
      "lines": [
        "* \"May I see the form?\"",
        "* \"Lovely handwriting.\"",
        "* \"The captain is coming!\""
      ]
    },
    {
      "id": "morgan_win_kill",
      "speaker": "narrator",
      "lines": [
        "* Morgan's pen rolls away.",
        "* The barrier arm stays up.",
        "* Nobody checks your bag."
      ]
    },
    {
      "id": "morgan_win_spare",
      "speaker": "narrator",
      "lines": [
        "* Morgan stamps your hand.",
        "* APPROVED. He means it.",
        "* \"Go on. Mind the kettle.\""
      ]
    },
    {
      "id": "demo_end_card",
      "speaker": "narrator",
      "lines": [
        "* END OF THE DEMO.",
        "* The veil thins tonight.",
        "* Thank you for playing."
      ]
    },
    {
      "id": "quay_morgan_pre",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* Rain walks sideways here.",
            "* Captain Morgan waits,",
            "* clipboard bone dry."
          ]
        },
        {
          "speaker": "morgan",
          "portrait": "guard",
          "lines": [
            "* \"Name. Business. STORM.\"",
            "* His eyes are all cloud.",
            "* The pen crackles."
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* The storm is wearing him.",
            "* Free him, somehow."
          ]
        }
      ]
    },
    {
      "id": "quay_morgan_intro",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* Captain Morgan salutes.",
            "* Thunder salutes back.",
            "* Talk him round, or fight."
          ]
        }
      ]
    },
    {
      "id": "quay_morgan_win_spare",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* The cloud leaves his eyes.",
            "* \"Was I shouting? Sorry.\"",
            "* He puts the pen away."
          ]
        }
      ]
    },
    {
      "id": "quay_morgan_win_kill",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* Captain Morgan sits down.",
            "* The clipboard floats off.",
            "* The rain does not stop."
          ]
        }
      ]
    },
    {
      "id": "quay_morgan_after_spare",
      "speaker": "morgan",
      "portrait": "guard",
      "pages": [
        {
          "speaker": "morgan",
          "portrait": "guard",
          "lines": [
            "* \"Where did my cap go?\"",
            "* \"Never mind. Thank you.\"",
            "* \"Go. Percy is worse.\""
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* The wind sulks south.",
            "* The bridge is calling."
          ]
        }
      ]
    },
    {
      "id": "quay_morgan_after_kill",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* Morgan does not get up.",
            "* The wind keeps his cap.",
            "* Nobody says anything."
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* The bridge is calling."
          ]
        }
      ]
    },
    {
      "id": "quay_morgan_thanks",
      "speaker": "morgan",
      "portrait": "guard",
      "pages": [
        {
          "speaker": "morgan",
          "portrait": "guard",
          "lines": [
            "* \"Thank you. Truly.\"",
            "* \"The clipboard says go.\"",
            "* \"I never did read it.\""
          ]
        }
      ]
    },
    {
      "id": "quay_bridge_wind",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* The wind shoves you back.",
            "* The bridge is not for you.",
            "* Not while Morgan rages."
          ]
        }
      ]
    },
    {
      "id": "quay_percy_pre",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* The bridge groans.",
            "* Percy stands at its end,",
            "* trident up, hair wild."
          ]
        },
        {
          "speaker": "percy",
          "portrait": "percy",
          "lines": [
            "* \"I CALLED THE STORM.\"",
            "* \"No. It called ME.\"",
            "* \"STAND BACK. I CANNOT.\""
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* This hurricane is his.",
            "* Stop him. Bring him back."
          ]
        }
      ]
    },
    {
      "id": "quay_percy_intro",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* Percy raises the trident.",
            "* The sea stands behind him.",
            "* Talk him down, or fight."
          ]
        }
      ]
    },
    {
      "id": "quay_percy_flicker",
      "speaker": "percy",
      "portrait": "percy",
      "pages": [
        {
          "speaker": "percy",
          "portrait": "percy",
          "lines": [
            "* \"Wait. Who says my name?\"",
            "* The trident dips an inch."
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* Then the storm yanks him",
            "* back. Again!"
          ]
        }
      ]
    },
    {
      "id": "quay_percy_win_spare",
      "speaker": "percy",
      "portrait": "percy",
      "pages": [
        {
          "speaker": "percy",
          "portrait": "percy",
          "lines": [
            "* \"The sea... is quiet?\"",
            "* \"Did I do all this?\""
          ]
        }
      ]
    },
    {
      "id": "quay_percy_win_kill",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* The trident falls first.",
            "* Then the man.",
            "* The sea goes flat."
          ]
        }
      ]
    },
    {
      "id": "quay_percy_after_spare",
      "speaker": "percy",
      "portrait": "percy",
      "pages": [
        {
          "speaker": "percy",
          "portrait": "percy",
          "lines": [
            "* \"I remember. All of it.\"",
            "* \"Sorry about the roofs.\"",
            "* \"And the weather.\""
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* The clouds tear open.",
            "* Gulls, of all things."
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* PERCY JOINS THE PARTY!"
          ]
        }
      ]
    },
    {
      "id": "quay_percy_after_kill",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* The wind drops at once.",
            "* One gull complains.",
            "* It is very quiet."
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* The sea is a mirror.",
            "* You did this too."
          ]
        }
      ]
    },
    {
      "id": "quay_dock_office",
      "speaker": "narrator",
      "pages": [
        {
          "speaker": "narrator",
          "lines": [
            "* Counter. A lamp. A ledger.",
            "* Two men. One is Navy.",
            "* The other owns the kettle."
          ]
        },
        {
          "speaker": "clerk",
          "lines": [
            "* \"You are the last one.\"",
            "* \"Name, then. Slowly.\"",
            "* The pen is already wet."
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* A line left in the ledger.",
            "* The ink on it is dry.",
            "* Beside it: a tea ring."
          ]
        }
      ]
    },
    {
      "id": "quay_dock_office_pass",
      "speaker": "clerk",
      "pages": [
        {
          "speaker": "clerk",
          "lines": [
            "* \"Berth nine. Deck two.\"",
            "* \"Do not leave the cabin.\"",
            "* He tears a pink slip."
          ]
        },
        {
          "speaker": "sailor",
          "lines": [
            "* \"Sign it and come on.\"",
            "* \"I have a ladder to hold.\"",
            "* \"It is holding my tea.\""
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* The slip changes hands.",
            "* It is warm from a pocket.",
            "* The gate shuts behind you."
          ]
        }
      ],
      "sets": [
        "has_boarding_pass"
      ]
    }
  ]
}
